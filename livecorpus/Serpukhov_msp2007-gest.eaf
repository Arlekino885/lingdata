    <TIER ANNOTATOR="@udr2006f" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@msp2007f" PARTICIPANT="@msp2007f" TIER_ID="gestComment@msp2007f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a354" ANNOTATION_REF="a294">
                <ANNOTATION_VALUE>мне кажется это еще может быть скованный изобразительный жест, показывающий противопоставление мужского монастыря женскому</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a355" ANNOTATION_REF="a295">
                <ANNOTATION_VALUE>скорее всего интервьюер улыбнулся, а информатор улыбнулся в ответ и отвел глаза, чтобы сдержать улыбку</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a356" ANNOTATION_REF="a302">
                <ANNOTATION_VALUE>предыдущее предложение почти полностью повторенно, и дублирование предыдущего жеста, как бы с иронией, подчеркивает повторение в речи</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
